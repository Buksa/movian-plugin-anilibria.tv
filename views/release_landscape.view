// AniLibria release page: persistent context with tabbed content.
#import "release_components.view"


widget(container_z, {
  widget(container_z, {
    hidden: $self.model.loading || $self.model.error ||
      $self.model.metadata.showOverview;

    widget(quad, {
      color: [0.035, 0.045, 0.085];
    });

    widget(container_y, {
      padding: [0.9em, 1.2em];
      spacing: 0.65em;

      widget(container_x, {
        height: 3.1em;
        spacing: 0.8em;
        widget(container_y, {
          filterConstraintX: true;
          widget(label, {
            caption: $self.model.metadata.title;
            sizeScale: 2.0;
            maxlines: 1;
          });
          widget(label, {
            caption: $self.model.metadata.subtitle;
            hidden: !$self.model.metadata.subtitle;
            sizeScale: 0.82;
            color: 0.65;
          });
        });
        widget(dummy, { });
        RELEASE_STATUS_BADGE();
      });

      widget(container_x, {
        height: $ui.height * 0.78;
        spacing: 1.35em;

        // Persistent release context.
        widget(container_y, {
          weight: 0.9;
          filterConstraintX: true;
          spacing: 0.42em;

          RELEASE_POSTER_CARD();

          widget(label, {
            caption: $self.model.metadata.year;
            sizeScale: 0.95;
            color: 0.85;
          });
          widget(label, {
            caption: $self.model.metadata.genres;
            sizeScale: 0.8;
            color: 0.68;
            maxlines: 2;
          });
          widget(label, {
            caption: $self.model.metadata.description;
            sizeScale: 0.8;
            color: 0.78;
            maxlines: 8;
          });
          RELEASE_OVERVIEW_BUTTON();

          RELEASE_RESUME_BUTTON();
        });

        // Active content panel.
        widget(container_y, {
          weight: 2.1;
          filterConstraintX: true;
          spacing: 0.45em;

          widget(container_x, {
            hidden: !$self.model.metadata.hasSecondaryTabs;
            height: 2.4em;
            spacing: 0.45em;
            RELEASE_TAB_BUTTON("episodes", "СЕРИИ",
              $self.model.metadata.episodeCount, true);
            RELEASE_TAB_BUTTON("franchise", "ФРАНШИЗА",
              $self.model.metadata.franchiseCount,
              $self.model.metadata.franchiseCount > 0);
            RELEASE_TAB_BUTTON("torrents", "ТОРРЕНТЫ",
              $self.model.metadata.torrentCount,
              $self.model.metadata.torrentCount > 0);
            widget(dummy, { });
          });

          widget(container_z, {
            weight: 1;

            // Episodes.
            widget(container_y, {
              hidden: $self.model.metadata.activeTab != "episodes";
              spacing: 0.3em;
              widget(container_x, {
                height: 1.7em;
                widget(label, {
                  caption: "Серии";
                  sizeScale: 1.2;
                });
                widget(dummy, { });
                widget(label, {
                  caption: $self.model.metadata.episodeCount;
                  sizeScale: 0.76;
                  color: 0.58;
                });
              });
              widget(container_z, {
                hidden: $self.model.metadata.episodeCount > 0;
                widget(label, {
                  caption: "Серии пока не опубликованы";
                  align: center;
                  sizeScale: 1.0;
                  color: 0.62;
                });
              });
              widget(container_x, {
                hidden: !($self.model.metadata.episodeCount > 0);
                widget(list_y, {
                  .id = "release-episodes";
                  spacing: 0.28em;
                  chaseFocus: true;
                  cloner($self.model.nodes, container_z, {
                    RELEASE_EPISODE_ROW();
                  });
                });
                LIST_Y_SLIDER("release-episodes", true);
              });
            });

            // Franchise releases.
            widget(container_y, {
              hidden: $self.model.metadata.activeTab != "franchise";
              spacing: 0.45em;
              widget(label, {
                caption: $self.model.metadata.franchise.title;
                sizeScale: 1.15;
                maxlines: 1;
              });
              widget(label, {
                hidden: !$self.model.metadata.franchise.info;
                caption: $self.model.metadata.franchise.info;
                sizeScale: 0.76;
                color: 0.62;
                maxlines: 1;
              });
              widget(list_x, {
                spacing: 0.65em;
                cloner($self.model.metadata.franchise.releases,
                  container_z, {
                    RELEASE_FRANCHISE_CARD();
                  });
              });
            });

            // Torrent groups.
            widget(container_y, {
              hidden: $self.model.metadata.activeTab != "torrents";
              spacing: 0.35em;
              widget(label, {
                caption: "Торренты";
                sizeScale: 1.2;
              });
              widget(container_x, {
                widget(list_y, {
                  .id = "release-torrents";
                  spacing: 0.5em;
                  chaseFocus: true;
                  cloner($self.model.metadata.torrentGroups,
                    container_y, {
                      spacing: 0.25em;
                      widget(label, {
                        caption: $self.quality;
                        height: 1.5em;
                        sizeScale: 0.9;
                        color: [0.5, 0.72, 1.0];
                      });
                      cloner($self.items, container_z, {
                        RELEASE_TORRENT_ROW();
                      });
                    });
                });
                LIST_Y_SLIDER("release-torrents", true);
              });
            });
          });
        });
      });
    });
  });

  RELEASE_LOADING_AND_ERROR();
  RELEASE_OVERVIEW_OVERLAY();
});
