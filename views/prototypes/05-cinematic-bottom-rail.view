// Prototype 5: Cinematic bottom rail
// Full-screen artwork with a readable title block and a horizontal episode shelf.
#import "../release_components.view"

#define CINEMATIC_EPISODE_CARD() {
  width: 10em;
  height: 6.1em;
  focusable: true;
  onEvent(activate, navOpen($self.url));

  // Focus highlight for the active episode card.
  widget(quad, {
    color: [1, 1, 1];
    alpha: select(isNavFocused(), 0.24, 0.06);
  });

  // Episode preview artwork.
  widget(image, {
    source: $self.display.preview;
    aspectConstraint: true;
  });

  // Bottom title strip inside the episode card.
  widget(container_z, {
    align: bottom;
    height: 2.2em;

    // Semi-transparent title strip background.
    widget(quad, {
      color: [0.02, 0.025, 0.05];
      alpha: 0.65;
    });

    // Episode number and title labels.
    widget(container_y, {
      padding: [0.18em, 0.3em];
      widget(label, {
        caption: "EP " + $self.display.episode;
        sizeScale: 0.82;
        bold: true;
      });
      widget(label, {
        caption: $self.display.title;
        sizeScale: 0.63;
        color: 0.84;
        maxlines: 1;
      });
    });
  });

  // Visible focus frame above the artwork and title strip.
  widget(border, {
    border: 0.12em;
    color: [1, 1, 1];
    alpha: 0.8 * iir(isNavFocused() + isHovered(), 4);
  });
}

widget(container_z, {
  width: $ui.width;
  height: $ui.height;
  widget(backdrop, {
    source: $self.model.metadata.poster_landscape;
    width: $ui.width;
    height: $ui.height;
    filterConstraintX: true;
    filterConstraintY: true;
    alpha: 0.55;
    color: 0.85;
  });

  // Global readability veil; keep it light so cards and artwork stay visible.
  widget(quad, {
    color: [0.025, 0.035, 0.08];
    alpha: 0.32;
  });

  widget(container_y, {
    align: bottom;
    padding: [1em, 1.3em];
    spacing: 0.55em;

    widget(label, {
      caption: $self.model.metadata.title;
      sizeScale: 2.4;
      maxlines: 1;
    });

    widget(container_x, {
      spacing: 0.7em;
      widget(label, {
        caption: $self.model.metadata.subtitle;
        hidden: !$self.model.metadata.subtitle;
        sizeScale: 0.95;
        color: 0.75;
      });
      widget(label, {
        caption: $self.model.metadata.year;
        sizeScale: 0.9;
        color: 0.82;
      });
      widget(label, {
        caption: "• " + $self.model.metadata.status;
        sizeScale: 0.9;
        color: [0.45, 0.9, 0.55];
      });
      widget(label, {
        caption: "• " + $self.model.metadata.ageRating;
        hidden: !$self.model.metadata.ageRating;
        sizeScale: 0.9;
        color: 0.72;
      });
    });

    widget(label, {
      caption: $self.model.metadata.description;
      maxlines: 3;
      sizeScale: 0.9;
      color: 0.82;
    });

    widget(label, {
      caption: "Эпизоды";
      sizeScale: 1.15;
      color: 0.95;
    });

    HORIZONTAL_FOCUS_LIST(
      "cinematic-episodes",
      6.4em,
      0.65em,
      $self.model.nodes,
      CINEMATIC_EPISODE_CARD
    );
  });
});
